# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/digital-store?retryWrites=true&w=majority

# Admin login password
ADMIN_PASSWORD=change-this-password

# Min 32 characters. Used to sign cookies (HMAC SHA256).
# Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-random-string-of-at-least-32-characters

# Payment verification API (server-side only, never use NEXT_PUBLIC_ for these)
PAYMENT_API_URL=https://sky-post-upload-jq4a.onrender.com
PAYMENT_API_KEY=<YOUR_API_KEY>

# Optional: hours of access after a verified payment (default 24)
ACCESS_HOURS=24

# Optional: public site URL (falls back to VERCEL_PROJECT_PRODUCTION_URL, then http://localhost:3000)
NEXT_PUBLIC_SITE_URL=
